# Flow OS build parameters.
# Read by the Justfile (`set dotenv-filename` at the top) and by CI.

# Output image name.
# Keep this identical to the GitHub repo name: .github/workflows/build-disk.yml
# derives IMAGE_NAME from the repo name, and the two must agree or the ISO job
# will look for an image that was never pushed.
IMAGE_NAME=flow

# GitHub user or org that owns the repo.
# Images publish to ghcr.io/$REPO_ORGANIZATION/$IMAGE_NAME
REPO_ORGANIZATION="tundra8x"

IMAGE_DESC="Flow - a gaming OS with a modern desktop, built on Bazzite"
IMAGE_KEYWORDS="bootc,oci,linux,gaming,flow,desktop,proton"

IMAGE_LOGO_URL="https://raw.githubusercontent.com/tundra8x/flow/main/branding/logo.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
